*HEADING
Span Modal Analysis
***********************************     
**Loading Condition: AsLaid
**Span_No: 10
**MetOcean: P30
**Unit in N , m and Pa
***********************************
*PREPRINT, HISTORY=NO,ECHO=YES,MODEL=YES
*PARAMETER  
##################################################### 
**INPUT PARAMETERS
#####################################################     
**Pipe cross section properties  
OUTER_DIA=0.244475
PIPE_THICK=0.039
COATING_THICK=0.0889
STEEL_DENSITY=7850
COATING_DENSITY=725.6
CONTENT_DENSITY=0
YOUNGS_MODULUS=200000000000
**
**Effective tension, positive value in tension, in N
Effect_TENSION=159.77*1000.0
** 
** Mesh sizes determined in pipe node coordinates
MESH_SIZE=1
**
**Span lengths and shoulder lengths
**Model includes threespans and
**shoulder_left, shoulder_middles, and shoulder_right
**
************************************************
SPAN_ONE_LENGTH=40
SPAN_TWO_LENGTH=60
SPAN_THREE_LENGTH=12
**SPAN_FOUR_LENGTH=
**SPAN_FIVE_LENGTH=
**SPAN_SIX_LENGTH=
**SPAN_SEVEN_LENGTH=
**SPAN_EIGHT_LENGTH=
**SPAN_NINE_LENGTH=
**SPAN_TEN_LENGTH=
************************************************
SHOULDER_LEFT_LENGTH=100
SHOULDER_MIDDLE_1_LENGTH=7
SHOULDER_MIDDLE_2_LENGTH=4
**SHOULDER_MIDDLE_3_LENGTH=
**SHOULDER_MIDDLE_4_LENGTH=
**SHOULDER_MIDDLE_5_LENGTH=
**SHOULDER_MIDDLE_6_LENGTH=
**SHOULDER_MIDDLE_7_LENGTH=
**SHOULDER_MIDDLE_8_LENGTH=
**SHOULDER_MIDDLE_9_LENGTH=
SHOULDER_RIGHT_LENGTH=100
**
************************************************
**SPAN START NODE NUMBER IN THE MODEL
SPAN_START_ND=1001021
**
**SOIL SPRING STIFFNESS(in N/m) in axial, lateral, and vertical directions
**Calculated as soil dynamic vertical stiffness (N/m/m) * Mesh_Size
**Soil dynamic stiffness from Fatfree per DNV-RP-105 for dense sand
**Note the model only considers the dynamic soil springs
**
**KV_PIPE=2.818E+06*MESH_SIZE
**KL_PIPE=1.825E+06*MESH_SIZE
**KA_PIPE=KL_PIPE
**
SOIL_SPR_K_AXIAL=1.825E+06 * MESH_SIZE 
SOIL_SPR_K_LAT=1.825E+06 * MESH_SIZE
SOIL_SPR_K_VER=2.818E+06 * MESH_SIZE
**
SEABED_ELEVATION=-1225.12
AQUA_ELEVATION=-1725.12
GRAV_AMP=9.81
WATER_DENSITY=1025
**
**Transverse added-mass coefficient CA
**Per DNV RP-F105-2006 6.9.1
**CA=0.68+1.6/(1+5e/D) for e/D<0.8; CA=1.0 for e/D>=0.8; e is the span gap
**Note that CA input here is considered for the long span to be evaluated
CA=1
**
##################################################### 
**END OF INPUT PARAMETERS
##################################################### 
**START AND END NODES TO REPORT MODE SHAPE
SPAN_LENGTH=SPAN_ONE_LENGTH+SPAN_TWO_LENGTH+SPAN_THREE_LENGTH+SHOULDER_MIDDLE_1_LENGTH+SHOULDER_MIDDLE_2_LENGTH
**
************************************************
SPAN_END_ND=1001144
**To define node sets to report span deflections
SPAN_START_ND_LEFT=SPAN_START_ND-10
SPAN_END_ND_RIGHT=SPAN_END_ND+10
**
SHOULDER_LEFT_START_ND=1000969
SHOULDER_LEFT_END_ND=SPAN_START_ND
**
SHOULDER_MIDDLE_1_START_ND=1001061
SHOULDER_MIDDLE_1_END_ND=1001068
**
SHOULDER_MIDDLE_2_START_ND=1001128
SHOULDER_MIDDLE_2_END_ND= 1001132
**
******************SHOULDER_MIDDLE_3_START_ND=SHOULDER_MIDDLE_2_END_ND+int(round(SPAN_THREE_LENGTH/MESH_SIZE,0))
******************SHOULDER_MIDDLE_3_END_ND=SHOULDER_MIDDLE_3_START_ND+int(round(SHOULDER_MIDDLE_3_LENGTH/MESH_SIZE,0))
**
******************SHOULDER_MIDDLE_4_START_ND=SHOULDER_MIDDLE_3_END_ND+int(round(SPAN_FOUR_LENGTH/MESH_SIZE,0))
******************SHOULDER_MIDDLE_4_END_ND=SHOULDER_MIDDLE_4_START_ND+int(round(SHOULDER_MIDDLE_4_LENGTH/MESH_SIZE,0))
**
******************SHOULDER_MIDDLE_5_START_ND=SHOULDER_MIDDLE_4_END_ND+int(round(SPAN_FIVE_LENGTH/MESH_SIZE,0))
******************SHOULDER_MIDDLE_5_END_ND=SHOULDER_MIDDLE_5_START_ND+int(round(SHOULDER_MIDDLE_5_LENGTH/MESH_SIZE,0))
**
******************SHOULDER_MIDDLE_6_START_ND=SHOULDER_MIDDLE_5_END_ND+int(round(SPAN_SIX_LENGTH/MESH_SIZE,0))
******************SHOULDER_MIDDLE_6_END_ND=SHOULDER_MIDDLE_6_START_ND+int(round(SHOULDER_MIDDLE_6_LENGTH/MESH_SIZE,0))
**
******************SHOULDER_MIDDLE_7_START_ND=SHOULDER_MIDDLE_6_END_ND+int(round(SPAN_SEVEN_LENGTH/MESH_SIZE,0))
******************SHOULDER_MIDDLE_7_END_ND=SHOULDER_MIDDLE_7_START_ND+int(round(SHOULDER_MIDDLE_7_LENGTH/MESH_SIZE,0))
**
******************SHOULDER_MIDDLE_8_START_ND=SHOULDER_MIDDLE_7_END_ND+int(round(SPAN_EIGHT_LENGTH/MESH_SIZE,0))
******************SHOULDER_MIDDLE_8_END_ND=SHOULDER_MIDDLE_8_START_ND+int(round(SHOULDER_MIDDLE_8_LENGTH/MESH_SIZE,0))
**
******************SHOULDER_MIDDLE_9_START_ND=SHOULDER_MIDDLE_8_END_ND+int(round(SPAN_NINE_LENGTH/MESH_SIZE,0))
******************SHOULDER_MIDDLE_9_END_ND=SHOULDER_MIDDLE_9_START_ND+int(round(SHOULDER_MIDDLE_9_LENGTH/MESH_SIZE,0))
**
SHOULDER_RIGHT_START_ND=SPAN_END_ND
SHOULDER_RIGHT_END_ND=1001193
**
MODEL_START=SHOULDER_LEFT_START_ND
MODEL_END=SHOULDER_RIGHT_END_ND
MODEL_ENDE=SHOULDER_RIGHT_END_ND-1
**
NEXT_MODSTART=MODEL_START+1
TOT_NODE=MODEL_END-MODEL_START+1
TOT_ELEMENT=MODEL_END-MODEL_START
**
***************************To define X springs
SPR_X_START_LEFT=SHOULDER_LEFT_START_ND+2000000
SPR_X_START_MIDDLE_1=SHOULDER_MIDDLE_1_START_ND+2000000
SPR_X_START_MIDDLE_2=SHOULDER_MIDDLE_2_START_ND+2000000
**********SPR_X_START_MIDDLE_3=SHOULDER_MIDDLE_3_START_ND+2000000
**********SPR_X_START_MIDDLE_4=SHOULDER_MIDDLE_4_START_ND+2000000
**********SPR_X_START_MIDDLE_5=SHOULDER_MIDDLE_5_START_ND+2000000
**********SPR_X_START_MIDDLE_6=SHOULDER_MIDDLE_6_START_ND+2000000
**********SPR_X_START_MIDDLE_7=SHOULDER_MIDDLE_7_START_ND+2000000
**********SPR_X_START_MIDDLE_8=SHOULDER_MIDDLE_8_START_ND+2000000
**********SPR_X_START_MIDDLE_9=SHOULDER_MIDDLE_9_START_ND+2000000
SPR_X_START_RIGHT=SHOULDER_RIGHT_START_ND+2000000
**
***************************To define Y springs
SPR_Y_START_LEFT=SHOULDER_LEFT_START_ND+3000000
SPR_Y_START_MIDDLE_1=SHOULDER_MIDDLE_1_START_ND+3000000
SPR_Y_START_MIDDLE_2=SHOULDER_MIDDLE_2_START_ND+3000000
**********SPR_Y_START_MIDDLE_3=SHOULDER_MIDDLE_3_START_ND+3000000
**********SPR_Y_START_MIDDLE_4=SHOULDER_MIDDLE_4_START_ND+3000000
**********SPR_Y_START_MIDDLE_5=SHOULDER_MIDDLE_5_START_ND+3000000
**********SPR_Y_START_MIDDLE_6=SHOULDER_MIDDLE_6_START_ND+3000000
**********SPR_Y_START_MIDDLE_7=SHOULDER_MIDDLE_7_START_ND+3000000
**********SPR_Y_START_MIDDLE_8=SHOULDER_MIDDLE_8_START_ND+3000000
**********SPR_Y_START_MIDDLE_9=SHOULDER_MIDDLE_9_START_ND+3000000
SPR_Y_START_RIGHT=SHOULDER_RIGHT_START_ND+3000000
**
***************************To define Z springs
SPR_Z_START_LEFT=SHOULDER_LEFT_START_ND+4000000
SPR_Z_START_MIDDLE_1=SHOULDER_MIDDLE_1_START_ND+4000000
SPR_Z_START_MIDDLE_2=SHOULDER_MIDDLE_2_START_ND+4000000
**********SPR_Z_START_MIDDLE_3=SHOULDER_MIDDLE_3_START_ND+4000000
**********SPR_Z_START_MIDDLE_4=SHOULDER_MIDDLE_4_START_ND+4000000
**********SPR_Z_START_MIDDLE_5=SHOULDER_MIDDLE_5_START_ND+4000000
**********SPR_Z_START_MIDDLE_6=SHOULDER_MIDDLE_6_START_ND+4000000
**********SPR_Z_START_MIDDLE_7=SHOULDER_MIDDLE_7_START_ND+4000000
**********SPR_Z_START_MIDDLE_8=SHOULDER_MIDDLE_8_START_ND+4000000
**********SPR_Z_START_MIDDLE_9=SHOULDER_MIDDLE_9_START_ND+4000000
SPR_Z_START_RIGHT=SHOULDER_RIGHT_START_ND+4000000
**
***************************To spring numbers
SPR_ELEMENT_NUM_LEFT=SHOULDER_LEFT_END_ND-SHOULDER_LEFT_START_ND+1
SPR_ELEMENT_NUM_MIDDLE_1=SHOULDER_MIDDLE_1_END_ND-SHOULDER_MIDDLE_1_START_ND+1
SPR_ELEMENT_NUM_MIDDLE_2=SHOULDER_MIDDLE_2_END_ND-SHOULDER_MIDDLE_2_START_ND+1
**********SPR_ELEMENT_NUM_MIDDLE_3=SHOULDER_MIDDLE_3_END_ND-SHOULDER_MIDDLE_3_START_ND+1
**********SPR_ELEMENT_NUM_MIDDLE_4=int(round(SHOULDER_MIDDLE_4_LENGTH/MESH_SIZE,0))+1
**********SPR_ELEMENT_NUM_MIDDLE_5=int(round(SHOULDER_MIDDLE_5_LENGTH/MESH_SIZE,0))+1
**********SPR_ELEMENT_NUM_MIDDLE_6=int(round(SHOULDER_MIDDLE_6_LENGTH/MESH_SIZE,0))+1
**********SPR_ELEMENT_NUM_MIDDLE_7=int(round(SHOULDER_MIDDLE_7_LENGTH/MESH_SIZE,0))+1
**********SPR_ELEMENT_NUM_MIDDLE_8=int(round(SHOULDER_MIDDLE_8_LENGTH/MESH_SIZE,0))+1
**********SPR_ELEMENT_NUM_MIDDLE_9=int(round(SHOULDER_MIDDLE_9_LENGTH/MESH_SIZE,0))+1
SPR_ELEMENT_NUM_RIGHT=SHOULDER_RIGHT_END_ND-SHOULDER_RIGHT_START_ND+1
SPR_ELEMENT_NUM=SPR_ELEMENT_NUM_LEFT+SPR_ELEMENT_NUM_MIDDLE_1+SPR_ELEMENT_NUM_MIDDLE_2+SPR_ELEMENT_NUM_RIGHT
**
**
***************************To equivalent density
TOTAL_OD=OUTER_DIA+2*COATING_THICK
TOTAL_BUOY_OD=1.07
OUTER_RADIUS=OUTER_DIA/2.       
INNER_DIA=OUTER_DIA-2.0*PIPE_THICK    
PIPE_AREA=3.14159*(OUTER_DIA**2 - INNER_DIA**2)/4.0
COATING_AREA=3.14159*((OUTER_DIA+2*COATING_THICK)**2 - OUTER_DIA**2)/4.0
FLUID_AREA=3.14159*(INNER_DIA**2)/4.0
**
EQV_DENSITY=(PIPE_AREA*STEEL_DENSITY+COATING_AREA*COATING_DENSITY+FLUID_AREA*CONTENT_DENSITY)/PIPE_AREA
BUOYANCY=3.14159*(TOTAL_OD**2)/4.0*WATER_DENSITY*GRAV_AMP
INI_S11=Effect_TENSION/PIPE_AREA
**
