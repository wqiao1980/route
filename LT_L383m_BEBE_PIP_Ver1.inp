***
*****************************************************
**  Step 1, initial setup on flat seabed  
*****************************************************   
*Step, name=Initial, Nlgeom=YES, Inc=10000, Unsymm=YES
Initial setup on flat seabed    
*Static, Stabilize=<STABILIZER> 
0.1, 1., 1e-15, 0.5    
**
*MODEL CHANGE, TYPE = CONTACT PAIR, REMOVE
RISER_SURF, SEABED2
RS_SURF, SEABED2
FITTING_SURF, SEABED2
**
*CONTROLS, PARAMETERS=TIME INCREMENTATION
 8, 10, , , , , , 30
 0.5, , , , 0.5, 0.5       
*CONTROLS,PARAMETERS=FIELD, FIELD=DISPLACEMENT
 , 1.0
*CONTROLS,PARAMETERS=FIELD, FIELD=ROTATION
 , 1.0
** 
*Boundary, OP=NEW        
REFND,ENCASTRE  
REFND2,ENCASTRE  
**
<START_ND_NO>, 1,2  
<START_ND_NO>, 4,6
**
<END_ND_NO>, 2, 2  
<END_ND_NO>, 4, 6
**
PIPE, 2, 2
PIPE, 4, 4
PIPE, 6, 6
BR_OUT, 2, 2
BR_OUT, 4, 4
BR_OUT, 6, 6
**
*DLOAD, OP=NEW  
**apply weight
RISER_BS,PZ,<WEIGHT_BEND_RS>
RISER,PZ,<WEIGHT_EMPTY_RISER>
FITTING, PZ, <WEIGHT_EMPTY_FIT>
**
**
*CLOAD, OP=NEW, FOLLOWER
<END_ND_NO>, 1,  <TX_LAY_END>
**
*********   Output Requests ****************
********************************************
**
*OUTPUT,FIELD,FREQ=1000        
*NODE OUTPUT
U,NT, COORD, RF    
*ELEMENT OUTPUT   
ESF1, SE, SF, THE 
*Contact Output       
cstress,cdisp     
*OUTPUT,HISTORY,FREQ=10000
*NODE OUTPUT,NSET=ND_START 
U
*NODE OUTPUT,NSET=ND_END 
U
***
*End Step 
***   
****************************************************************
***** Step 2 Apply Seabed Slope
****************************************************************
*Step, Nlgeom=YES, Inc=20000, Unsymm=YES     
APPLY SEABED SLOPE 
*Static, Stabilize=2.E-6  
0.001, 1., 1.0e-15, 0.1
**   
*Boundary, OP=NEW 
REFND, 1, 4
REFND, 5, 5, -<SLOPE_ANGLE>
REFND, 6, 6
REFND2, 1, 4
REFND2, 5, 5, -<SLOPE_ANGLE>
REFND2, 6, 6
**     
<START_ND_NO>, 1,2
<START_ND_NO>, 4,5
<START_ND_NO>, 6,6, <SETA_X>
**
<END_ND_NO>, 2, 2  
<END_ND_NO>, 4, 6
**
BR_OUT, 4, 4 
**
*Cload, OP=NEW, FOLLOWER
<END_ND_NO>, 1,  <TX_LAY_END>
**
*End Step
****************************************************************
***** Step 3 CHANGE FRICTION SURFACE
****************************************************************
*Step, Nlgeom=YES, Inc=20000, Unsymm=YES     
CHANGE FRICTION SURFACE
*Static, Stabilize=2.0E-6  
0.1, 1., 1.0e-15, 0.1
** 
*MODEL CHANGE, TYPE=CONTACT PAIR, ADD
RISER_SURF, SEABED2
RS_SURF, SEABED2
FITTING_SURF, SEABED2
**
*End Step
**
